{
  "name": "@abca/cdk",
  "version": "0.0.0",
  "private": true,
  "description": "ABCA CDK application",
  "license": "MIT-0",
  "_cedar_parity_pin": "DO NOT BUMP @cedar-policy/cedar-wasm IN ISOLATION. The Python cedarpy binding (agent/pyproject.toml) and this WASM binding share a Rust core and must move together. Drift between bindings can produce divergent (decision, matching_rule_ids) on the same (policy, input). See docs/design/CEDAR_HITL_GATES.md §15.6 (decision #23). The contracts/cedar-parity/ golden fixtures are how CI catches divergence; bumping either side requires bumping the other AND refreshing the fixtures in the same commit.",
  "scripts": {
    "compile": "tsc --build tsconfig.json",
    "watch": "tsc --build -w tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest --ci --maxWorkers=${JEST_MAX_WORKERS:-25%}",
    "synth": "npx cdk synth",
    "synth:quiet": "npx cdk synth -q",
    "census": "node -r ts-node/register/transpile-only src/synthesis/cli.ts"
  },
  "dependencies": {
    "@aws-cdk/aws-bedrock-alpha": "2.276.0-alpha.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-agent-registry-control": "^3.1166.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1166.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1166.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1166.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1166.0",
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/client-ec2": "^3.1166.0",
    "@aws-sdk/client-ecs": "^3.1166.0",
    "@aws-sdk/client-lambda": "^3.1166.0",
    "@aws-sdk/client-lambda-microvms": "^3.1166.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/client-secrets-manager": "^3.1166.0",
    "@aws-sdk/client-sns": "^3.1166.0",
    "@aws-sdk/client-ssm": "^3.1166.0",
    "@aws-sdk/client-sts": "^3.1166.0",
    "@aws-sdk/credential-provider-node": "^3.972.96",
    "@aws-sdk/lib-dynamodb": "^3.1166.0",
    "@aws-sdk/s3-presigned-post": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@aws/durable-execution-sdk-js": "^3.0.0",
    "@cedar-policy/cedar-wasm": "4.12.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5",
    "aws-cdk-lib": "^2.276.0",
    "aws-jwt-verify": "^5.2.1",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.8.1",
    "js-yaml": "^5.5.0",
    "pdf-parse": "2.4.5",
    "ulid": "^3.0.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@cdklabs/eslint-plugin": "^2",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "^5",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "aws-cdk": "^2",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import-x": "^4",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-license-header": "^0.9.0",
    "jest": "^30.5.2",
    "jest-junit": "^17",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "resolutions": {},
  "engines": {
    "node": "^22.23.4 || ^24.15.0"
  },
  "jest": {
    "cacheDirectory": "<rootDir>/.jest-cache",
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)"
    ],
    "maxWorkers": "25%",
    "workerIdleMemoryLimit": "1536MB",
    "clearMocks": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "scripts/generate-bootstrap-template.ts"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 95,
        "lines": 93,
        "statements": 93
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFiles": [
      "<rootDir>/test/setup/disable-bundling.ts"
    ],
    "setupFilesAfterEnv": [
      "aws-cdk-lib/testhelpers/jest-autoclean"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ]
    }
  }
}
