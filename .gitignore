!.node-version
!.ort.yml
!/.github/workflows/build.yml
!/.github/workflows/docs.yml
!/.github/pull_request_template.md
!/.mergify.yml
!/cdk/test/
!/cdk/tsconfig.json
!/cdk/tsconfig.dev.json
!/cdk/src/
!/cdk/.eslintrc.json
!/cdk/cdk.json
