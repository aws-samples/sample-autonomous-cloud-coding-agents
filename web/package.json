{
  "name": "@abca/web",
  "version": "0.0.0",
  "private": true,
  "description": "ABCA operator console: single-page React + Cloudscape app served from CloudFront",
  "license": "MIT-0",
  "type": "module",
  "scripts": {
    "start": "node scripts/fetch-live-config.mjs && vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vite.config.ts --coverage --allowOnly=false",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudscape-design/components": "^3.0.1404",
    "@cloudscape-design/global-styles": "^1.0.71",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "eslint-plugin-license-header": "^0.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
