{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".semgrep/**"
  ],
  "ignoreBinaries": [
    "mise",
    "semgrep"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{js,mjs,ts}"]
    },
    "cdk": {
      "entry": ["src/main.ts!", "src/handlers/*.ts!", "scripts/*.ts", "test/integ/integ.*.ts"],
      "project": ["src/**/*.ts!", "scripts/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["tsx", "@aws-cdk/integ-runner"]
    },
    "cli": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "docs": {
      "entry": ["src/components/**/*.astro", "scripts/*.mjs"],
      "project": ["src/**/*.{astro,ts,tsx}", "scripts/**/*.mjs", "plugins/**/*.mjs"],
      "ignoreDependencies": ["markdown-link-check", "@pagefind/default-ui", "jest"]
    },
    "integrations/jira-forge-app": {
      "entry": ["src/index.js!", "test/**/*.test.js"],
      "project": ["src/**/*.js!", "test/**/*.js"]
    },
    "web": {
      "entry": ["test/**/*.test.{ts,tsx}", "scripts/*.mjs"],
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.{ts,tsx}", "scripts/**/*.mjs"]
    }
  }
}
