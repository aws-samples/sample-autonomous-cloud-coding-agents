{
  "_comment": "Cross-language vectors for the two secret scanners: agent/src/output_scanner.py (tool output) and cdk/src/handlers/shared/deny-reason-scanner.ts (deny reasons). Both test suites (agent/tests/test_output_scanner.py, cdk/test/handlers/shared/deny-reason-scanner.test.ts) run every vector, so the pattern for a URL with a user and a password cannot change in one scanner alone. 'expected' is the text after the scan; where it equals 'input', the scanners leave the text as it is. Only shapes that both scanners replace by the same marker belong here. Every value is made up; the AWS key id is the example of the AWS documentation.",
  "vectors": [
    {
      "input": "DATABASE_URL=postgres://admin:s3cretP4ss@db.example.com:5432/mydb",
      "expected": "DATABASE_URL=[REDACTED-CONNECTION_STRING]",
      "note": "a password without a slash"
    },
    {
      "input": "EMAIL_URL=smtp://alerts@example.com:s3cretP4ss@smtp.example.com:587",
      "expected": "EMAIL_URL=[REDACTED-CONNECTION_STRING]",
      "note": "an e-mail address as user"
    },
    {
      "input": "postgres://admin:abc/def+ghiJKL@db.internal:5432/app",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "a password that holds a slash"
    },
    {
      "input": "REDIS_URL=redis://default:Zm9v/YmFy+QQ==@cache.internal:6379/0",
      "expected": "REDIS_URL=[REDACTED-CONNECTION_STRING]",
      "note": "a base64 password with a slash, a plus and padding"
    },
    {
      "input": "amqps://app:/x9Kp+2Lm=@mq.internal:5671/vhost",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "a password that begins with a slash"
    },
    {
      "input": "mongodb+srv://app:pa/ss/word@cluster0.example.net/app?retryWrites=true",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "a password with two slashes"
    },
    {
      "input": "EMAIL_URL=smtp://alerts@example.com:pa/ss@smtp.example.com:587",
      "expected": "EMAIL_URL=[REDACTED-CONNECTION_STRING]",
      "note": "an e-mail address as user and a slash in the password"
    },
    {
      "input": "postgres://admin:abc/def@[::1]:5432/app",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "a slash in the password and an IPv6 host"
    },
    {
      "input": "postgres://admin:123456/x@db.internal/app",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "six digits before the slash, which is no port"
    },
    {
      "input": "postgres://admin:2024Summer/x@db.internal/app",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "digits and letters before the slash, which is no port"
    },
    {
      "input": "http://localhost:3000/login?next=https://admin:pa/ss@example.com/x",
      "expected": "http://localhost:3000/login?next=[REDACTED-CONNECTION_STRING]",
      "note": "a URL with a password behind a plain URL with a port"
    },
    {
      "input": "postgres://admin:pa:ss/word@db.internal/app",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "a slash and a colon in the password"
    },
    {
      "input": "postgres://admin:@db.internal/app",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "a password of 600 characters with slashes and no colon"
    },
    {
      "input": "postgres://admin:ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/@db.internal/app",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "a password of 256 characters with slashes and colons"
    },
    {
      "input": "s3a://AKIAIOSFODNN7EXAMPLE:aB3/aB3/aB3/aB3/aB3/aB3/aB3/aB3/aB3/aB3/@bucket/path",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "an AWS key id as user and slashes in the secret"
    },
    {
      "input": "https://AKIAIOSFODNN7EXAMPLE:8443/x@files.example.com",
      "expected": "[REDACTED-CONNECTION_STRING]",
      "note": "an AWS key id as user, then digits and a slash"
    },
    {
      "input": "GET https://registry.example.com:8443/@acme/pkg 200",
      "expected": "GET https://registry.example.com:8443/@acme/pkg 200",
      "note": "a port, then a scoped package in the path"
    },
    {
      "input": "http://localhost:5173/@fs/Users/dev/app/src/main.ts",
      "expected": "http://localhost:5173/@fs/Users/dev/app/src/main.ts",
      "note": "a port, then /@fs/ in the path"
    },
    {
      "input": "https://chat.example.com:443/api/v10/users/@me",
      "expected": "https://chat.example.com:443/api/v10/users/@me",
      "note": "a port, then /users/@me in the path"
    },
    {
      "input": "docker://registry.internal:50000/team/image@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "expected": "docker://registry.internal:50000/team/image@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "note": "a port of five digits, then an image digest"
    },
    {
      "input": "http://localhost:3000/api/users/alice@example.com",
      "expected": "http://localhost:3000/api/users/alice@example.com",
      "note": "a port, then an e-mail address in the path"
    },
    {
      "input": "http://[::1]:5173/@vite/client",
      "expected": "http://[::1]:5173/@vite/client",
      "note": "an IPv6 host with a port, then an @ in the path"
    },
    {
      "input": "ssh://git@git.example.com:2222/team/repo.git@v1.2.0",
      "expected": "ssh://git@git.example.com:2222/team/repo.git@v1.2.0",
      "note": "a user without a password, a port, then an @ in the path"
    },
    {
      "input": "See https://example.com/docs\nAuthor: User <user@example.com>\n",
      "expected": "See https://example.com/docs\nAuthor: User <user@example.com>\n",
      "note": "a colon and an @ on the line after a URL"
    },
    {
      "input": "Docs are at https://example.com: ask ops@example.com for access.",
      "expected": "Docs are at https://example.com: ask ops@example.com for access.",
      "note": "a colon behind the host and an @ later in the sentence"
    },
    {
      "input": "https://example.com/a:b/c@d",
      "expected": "https://example.com/a:b/c@d",
      "note": "a colon and an @ behind the first slash"
    },
    {
      "input": "export PGURL=\"postgres://app:${DB_PASSWORD}@db.internal/app\"",
      "expected": "export PGURL=\"postgres://app:${DB_PASSWORD}@db.internal/app\"",
      "note": "a placeholder where the password stands"
    },
    {
      "input": "postgres://admin:ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/d@db.internal/app",
      "expected": "postgres://admin:ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/ab:/d@db.internal/app",
      "note": "257 characters with slashes and colons between the user and the @"
    }
  ]
}
