# pytest-cov writes per-process files (`.coverage.<host>.<pid>.<random>`) and removes them as it
# combines: a CDK asset fingerprint walk that stats one and then opens it fails with ENOENT.
.coverage
.coverage.*
coverage/

.pytest_cache/
.ruff_cache/
__pycache__/
**/__pycache__/
**/*.pyc

.venv/

gitleaks-report.json
